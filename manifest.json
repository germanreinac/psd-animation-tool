{
  "manifestVersion": 5,
  "id": "ps-animation-tool.frame-animator",
  "name": "Frame Animator",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "frameAnimatorPanel",
      "label": { "default": "Frame Animator" },
      "minimumSize": { "width": 230, "height": 320 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 620 },
      "preferredFloatingSize": { "width": 300, "height": 660 }
    },
    {
      "type": "panel",
      "id": "storyboardPanel",
      "label": { "default": "Storyboard" },
      "minimumSize": { "width": 200, "height": 200 },
      "maximumSize": { "width": 3000, "height": 3000 },
      "preferredDockedSize": { "width": 420, "height": 400 },
      "preferredFloatingSize": { "width": 640, "height": 480 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
